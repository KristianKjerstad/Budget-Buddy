{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch backend",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}