{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch backend",
            "type": "shell",
            "command": "/opt/homebrew/bin/dotnet",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/zsh",
                    "args": [
                        "-c"
                    ]
                }
            },
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build backend",
            "command": "/opt/homebrew/bin/dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/zsh",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": "$msCompile"
        }
    ]
}